{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "k8s-subduer",
  "version": "0.1.0",
  "identifier": "com.it-problems.k8s-subduer",
  "build": {
    "beforeDevCommand": "trunk serve",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "trunk build --release",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "k8s-subduer",
        "create": false,
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "publisher": "it-problems",
    "copyright": "Copyright © 2026 it-problems",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "resources": {
      "../THIRD-PARTY-NOTICES.txt": "THIRD-PARTY-NOTICES.txt"
    },
    "targets": "all",
    "icon": [
      "icons/256x256.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Browse and control Kubernetes clusters",
    "category": "DeveloperTool"
  }
}
